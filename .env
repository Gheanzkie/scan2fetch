#--------------------------------------------------------------------
# Example Environment Configuration file
#
# This file can be used as a starting point for your own
# custom .env files, and contains most of the possible settings
# available in a default install.
#
# By default, all of the settings are commented out. If you want
# to override the setting, you must un-comment it by removing the '#'
# at the beginning of the line.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

# app.baseURL = ''
# If you have trouble with `.`, you could also use `_`.
# app_baseURL = ''
# app.forceGlobalSecureRequests = false
app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = scan2fetch
database.default.username = root
database.default.password = 
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306


# app.baseURL = 'https://bolster-algorithm-tinderbox.ngrok-free.dev/'
 app.baseURL = 'http://localhost:8080/'
# app.baseURL = 'http://192.168.137.1:8080/'
# app.baseURL = ''

# php spark serve --host 0.0.0.0 --port 8080


# If you use MySQLi as tests, first update the values of Config\Database::$tests.
# database.tests.hostname = localhost
# database.tests.database = ci4_test
# database.tests.username = root
# database.tests.password = root
# database.tests.DBDriver = MySQLi
# database.tests.DBPrefix =
# database.tests.charset = utf8mb4
# database.tests.DBCollat = utf8mb4_general_ci
# database.tests.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

# Encryption key for the CI4 encrypter used to encrypt `messages.message` (AES-256-CTR).
# hex2bin: decrypts the 64-char hex string into the 32-byte raw key. Keep this key private & backed up.
encryption.key = hex2bin:e841f1a3fd77d8a6bcffd4ab2d269592b3560c99c3cd325e9392e2d5cfa0a543

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

# session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
# session.savePath = null

#--------------------------------------------------------------------
# SMS
#--------------------------------------------------------------------

# SMS simulation: when true, messages are only recorded in sms_logs
# (no real SMS is sent). Set to false when you want real delivery.
SMS_SIMULATION = false

# SMS gateway: 'textbee' (Android phone gateway, send via your own SIM).
SMS_GATEWAY = textbee

# --- TextBee ---
# Dashboard: https://textbee.dev  -> create API key, paste it below.
# Endpoint used: POST https://api.textbee.dev/api/v1/gateway/send-sms (header: x-api-key)
SMS_TEXTBEE_API_KEY = txb_6aEcY7QRL5p49jA1Wf1CFaS3bmEUHK1y
# Optional: force a specific paired phone (leave blank = account default device).
SMS_TEXTBEE_DEVICE_ID = 6acf8d4f74e21da91ae9e9d6

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

# logger.threshold = 4
