# writable/ keeps its folder structure in git via .gitkeep so a fresh clone
# has every directory CI4 needs (cache/session/logs/debugbar/uploads).
writable/session/*
!writable/session/.gitkeep
writable/debugbar/*
!writable/debugbar/.gitkeep
writable/logs/*
!writable/logs/.gitkeep
writable/cache/*
!writable/cache/.gitkeep
writable/uploads/*
!writable/uploads/.gitkeep

# Runtime uploads - real people's photos and QR images must never be committed
public/uploads/qr/*
public/uploads/parents/*
public/uploads/students/*
public/uploads/teachers/*
public/uploads/staffs/*
public/uploads/subfetchers/*
!public/uploads/*/.gitkeep

# Root-level uploads junction/symlink used by this XAMPP install
/uploads/

# Imported archives kept only on disk
public/uploads/*_source.zip

# Excel/Word lock files
~$*
